# --- Database (Postgres) ---
DATABASE_URL="postgresql://hfc:hfc_dev_password@localhost:5432/hfc?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Needed when running behind a proxy / on non-Vercel hosts
# AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that are promoted to SUPER_ADMIN on sign-in
SUPER_ADMIN_EMAILS="you@example.com"

# --- Dev-only "sign in as" login (never enable in production) ---
ENABLE_DEV_LOGIN=true

# --- Business rules ---
# Regular (wallet) members cannot order once their due would exceed this (BDT)
MAX_WALLET_DUE=1000

# --- Meal photo uploads (optional) ---
# If all three are set uploads go to Cloudinary; otherwise they are written to public/uploads (dev only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Seed ---
# The seeded SUPER_ADMIN account uses this email (so you can sign in with Google as the owner)
SEED_ADMIN_EMAIL="admin@hfc.example"
