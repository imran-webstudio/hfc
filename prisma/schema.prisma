generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
}

enum Slot {
  LUNCH
  DINNER
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  WALLET_CHARGED
  CASH_PAID
}

enum LedgerType {
  DEPOSIT
  DUE_PAYMENT
  ADJUSTMENT
  REFUND
  // Written (negative) when an order is created/edited/cancelled/deleted so the stored
  // balance always equals Total Deposit − Total Bill. NOT a deposit; excluded from Total Deposit.
  ORDER_BILL
  // Written (positive) when a delivered order is marked Cash Paid. Counts toward Total Deposit.
  CASH_PAYMENT
}

// ---------------------------------------------------------------- Auth.js
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role        Role        @default(USER)
  banned      Boolean     @default(false)

  // member profile
  employeeId String?
  phone      String?
  building   String? // free text written by the member (office name)
  floor      String?
  company    String?
  address    String?
  zoneId     String? // catering zone = office the admin assigned / profile selected
  zone       Office? @relation("UserZone", fields: [zoneId], references: [id], onDelete: SetNull)

  balance Int @default(0) // wallet balance in BDT; negative = due

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  orders         Order[]       @relation("OrderMember")
  placedOrders   Order[]       @relation("OrderPlacedBy")
  ledger         LedgerEntry[] @relation("LedgerMember")
  ledgerCreated  LedgerEntry[] @relation("LedgerCreatedBy")
  managedOffices OfficeManager[]
  auditLogs      AuditLog[]    @relation("AuditActor")
  auditSubject   AuditLog[]    @relation("AuditMember")

  @@index([zoneId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------- Offices
model Office {
  id            String  @id @default(cuid())
  name          String  @unique
  address       String?
  active        Boolean @default(true)
  lunchCutoff   String  @default("13:00") // HH:mm, Asia/Dhaka
  dinnerCutoff  String  @default("20:00")
  offerDinner   Boolean @default(true)
  createdAt     DateTime @default(now())

  members  User[]         @relation("UserZone")
  managers OfficeManager[]
  options  MenuOption[]
  orders   Order[]
  dayOffs  DayOff[]
  floors   Floor[]
}

// A named floor belonging to one building (Office). Dynamic: admins add/edit/delete
// floors from Staff. Members keep the floor NAME as a string on User.floor (snapshot
// simplicity for historical orders); profile/admin selections are validated against
// this registry.
model Floor {
  id       String @id @default(cuid())
  officeId String
  name     String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, name])
  @@index([officeId])
}

model OfficeManager {
  officeId String
  userId   String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([officeId, userId])
}

// One row per office per calendar day. A range is stored as consecutive rows sharing a note.
// "All offices" on the dashboard writes a row for every active office.
model DayOff {
  officeId String
  date     String // YYYY-MM-DD (Asia/Dhaka)
  note     String?
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@id([officeId, date])
}

// ---------------------------------------------------------------- Menu
// A MenuOption is either a weekly template (weekday set) or a dated meal (date set).
// Options created with "all locations" share a groupId so edits/removals apply to every office.
model MenuOption {
  id          String   @id @default(cuid())
  groupId     String
  officeId    String
  slot        Slot
  weekday     Int? // 0 = Sunday … 6 = Saturday
  date        String? // YYYY-MM-DD, for dated meals
  title       String
  description String?
  price       Int
  // Daily cap for the dish. Null = unlimited. Spec §5: the cap is a GLOBAL pool shared by
  // every office copy in the groupId — Remaining = maxQuantity − non-cancelled ordered
  // quantity summed across all office copies of this group for that meal date.
  // StockOut is a separate manual "don't serve today" override and is not written when the cap hits 0.
  maxQuantity Int?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  office    Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  stockOuts StockOut[]
  orderItems OrderItem[]

  @@index([officeId, weekday, slot])
  @@index([officeId, date, slot])
  @@index([groupId])
}

model StockOut {
  optionId String
  date     String
  option   MenuOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, date])
}

model SavedMeal {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int
  imageUrl    String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------- Orders & wallet
// One Order = one checkout: a single mealDate / office / member with a grand total
// (`amount`) and one or more OrderItems. Delivery status and payment status are fully
// independent (spec §6.8): delivery never charges; payment is a separate staff action.
model Order {
  id            String        @id @default(cuid())
  number        Int           @unique // human order number, shown as #HF000001, auto-increments from 1
  userId        String
  officeId      String
  mealDate      String // YYYY-MM-DD (Asia/Dhaka)
  amount        Int // grand total = sum of item subtotals, counted once in Total Bill
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  note          String?
  placedById    String? // set when an admin placed the order for the member
  createdAt     DateTime      @default(now())
  deliveredAt   DateTime?
  billedAt      DateTime? // set when the ORDER_BILL ledger entry is written (at delivery)
  cancelledAt   DateTime?
  paidAt        DateTime? // set by the Cash Paid / Wallet Charge action on a delivered order

  user     User        @relation("OrderMember", fields: [userId], references: [id], onDelete: Cascade)
  placedBy User?       @relation("OrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  office   Office      @relation(fields: [officeId], references: [id])
  items    OrderItem[]

  @@index([userId, createdAt])
  @@index([officeId, mealDate])
  @@index([mealDate])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  optionId  String? // SetNull: past items keep their snapshot if the dish is removed
  slot      Slot
  title     String // snapshot
  unitPrice Int // snapshot
  quantity  Int    @default(1)
  subtotal  Int // unitPrice * quantity

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  option MenuOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([optionId])
}

/** Named monotonic counters (e.g. id "order" → the next #HF order number). */
model Counter {
  id    String @id
  value Int    @default(0)
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  type         LedgerType
  amount       Int // signed change to balance
  balanceAfter Int
  note         String?
  createdById  String?
  createdAt    DateTime   @default(now())

  user      User  @relation("LedgerMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Staff-side audit trail for financial actions (spec §8.2). Deliberately NOT part of the
// member's account history: it survives Clear Order History so the reset itself is auditable.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  memberId  String
  action    String // DEPOSIT | EDIT_BALANCE | CASH_PAID | WALLET_CHARGE | ORDER_DELETE | CLEAR_HISTORY
  detail    String?
  amount    Int?
  createdAt DateTime @default(now())

  actor  User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  member User  @relation("AuditMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}
